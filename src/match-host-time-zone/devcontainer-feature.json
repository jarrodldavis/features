{
  "name": "Match Host Time Zone",
  "id": "match-host-time-zone",
  "version": "1.1.0",
  "description": "Match host timezone without mounting over tzdata-managed paths.",
  "mounts": [
    {
      "source": "/etc/localtime",
      "target": "/usr/local/share/host-localtime",
      "type": "bind",
      "readonly": true
    }
  ],
  "containerEnv": {
    "TZ": ":/usr/local/share/host-localtime"
  }
}
