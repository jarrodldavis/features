{
    "tilde_and_absolute_paths": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "persistent-dev-state": {
                "paths": "~/.codex;~/.npm;/usr/local/share/tool-cache"
            }
        }
    },
    "empty_paths": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "persistent-dev-state": {
                "paths": ""
            }
        }
    }
}
